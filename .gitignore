# macOS and editor metadata
.DS_Store
**/.DS_Store
*.swp
*.swo
*~
.idea/
.vscode/

# Local assistant and machine-specific configuration
.claude/
.env
.env.*
!.env.example

# Python bytecode, tooling caches, and build output
__pycache__/
*.py[cod]
*$py.class
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
.tox/
.nox/
build/
dist/
*.egg-info/

# Virtual environments
.venv/
venv/
env/
ENV/

# Logs, notebooks, and temporary files
*.log
logs/
.ipynb_checkpoints/
*.tmp
*.temp
tmp/
temp/

# Training outputs and model weights
checkpoints/*.pth
checkpoints/*.pt
checkpoints/*.ckpt
runs/*
!runs/README.md
artifacts/*
!artifacts/README.md

# Full/generated pretraining data. Keep only documented smoke fixtures.
data/pretrain_data/*
!data/pretrain_data/README.md
!data/pretrain_data/CHEMBL_smiles.csv
!data/pretrain_data/gtpro_smoke_*.npy

# Paper benchmark CSVs are tracked with provenance; other raw assets stay local.
data/downstream/**/raw/*
!data/downstream/bbbp/raw/BBBP.csv
!data/downstream/bace/raw/bace.csv
!data/downstream/sider/raw/sider.csv
!data/downstream/clintox/raw/clintox.csv
!data/downstream/tox21/raw/tox21.csv
